# Copy to scripts/gh/.env.local (gitignored) and fill in real webhook URLs.
# create_gh_release.py loads this file on startup when present.
# Do not commit .env.local.

# Required for --slack (default channel: #apm-python-release).
# Use a Slack Incoming Webhook (hooks.slack.com/services/...) so mrkdwn
# (*bold*, <url|label>, <@UID>) renders. Do NOT use a Workflow Builder
# "From a webhook" trigger URL (hooks.slack.com/triggers/...) — those
# insert `text` as plain/rich-text and show literals.
#
# Setup: Slack app → Incoming Webhooks → Add New Webhook to Workspace →
# pick #apm-python-release → copy the URL.
DDTRACE_RELEASE_APM_PYTHON_RELEASE_CHANNEL_URL=https://hooks.slack.com/services/REPLACE/ME/with-real-webhook

# Optional: personal DM Incoming Webhook for --test-dm
# DDTRACE_RELEASE_DM_URL=https://hooks.slack.com/services/REPLACE/ME/dm-webhook

# Optional escape hatch only (broken formatting): force-post through a
# Workflow Builder triggers/ URL for connectivity debugging.
# DDTRACE_RELEASE_ALLOW_WORKFLOW_TRIGGER=1
