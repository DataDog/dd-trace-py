# Copy to scripts/gh/.env.local (gitignored) and fill in real webhook URLs.
# create_gh_release.py loads this file on startup when present.
# Do not commit .env.local.

# Required for --slack (default channel: #apm-python-release)
DDTRACE_RELEASE_APM_PYTHON_RELEASE_CHANNEL_URL=https://hooks.slack.com/triggers/REPLACE/ME/with-real-webhook

# Optional: personal DM webhook for --test-dm
# DDTRACE_RELEASE_DM_URL=https://hooks.slack.com/triggers/REPLACE/ME/dm-webhook
