# Copy to scripts/gh/.env.local (gitignored) and fill in real webhook URLs.
# create_gh_release.py loads this file on startup when present.
# Do not commit .env.local.

# Required for --slack (default channel: #apm-python-release).
#
# Preferred (FR): Slack Incoming Webhook — hooks.slack.com/services/...
#   mrkdwn (*bold*, <url|label>, <@UID>) renders correctly.
#
# Interim: Workflow Builder trigger — hooks.slack.com/triggers/...
#   Script POSTs structured fields (version, kind, draft_url, …).
#   Rebuild the Workflow first: scripts/gh/SLACK_WORKFLOW_INTERIM.md
#   Freeform mrkdwn on triggers/ is refused (shows as literals).
#
# Setup (FR): Slack app → Incoming Webhooks → Add New Webhook →
# #apm-python-release → copy the URL.
DDTRACE_RELEASE_APM_PYTHON_RELEASE_CHANNEL_URL=https://hooks.slack.com/services/REPLACE/ME/with-real-webhook

# Optional: personal DM Incoming Webhook for --test-dm
# DDTRACE_RELEASE_DM_URL=https://hooks.slack.com/services/REPLACE/ME/dm-webhook

# Optional: Slack usergroup ID (S…) so Incoming Webhook mrkdwn notifies
# @dd-trace-py-releasers via <!subteam^S…|dd-trace-py-releasers>.
# Find it in Slack (copy link on the usergroup) or leave unset (plain @handle).
# DD_SLACK_RELEASERS_SUBTEAM_ID=S0123456789

# Rare: force structured Workflow JSON even when the URL is not triggers/
# DDTRACE_RELEASE_SLACK_WORKFLOW_STRUCTURED=1
