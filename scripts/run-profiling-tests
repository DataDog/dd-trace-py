#!/usr/bin/env bash
# One-button profiling test runner for the default (or requested) CPython minor.
#
# Default MAJOR.MINOR comes from scripts/profiles/profiling_versions.json
# (field default_python). Override with --python.
#
# Runs all profiling test suites on the target Python version:
#   - verify_profiler_compatibility.py (async guards + real profiler samples)
#   - profile      (main profiling suite: asyncio, stack, threading, lock, etc.)
#   - profile-memalloc  (memory allocator variants: malloc, pymalloc, debug)
#   - profile-uwsgi when the registry marks uwsgi_supported=true; otherwise SKIPPED
#
# Usage:
#   scripts/run-profiling-tests                  # default from profiling_versions.json
#   scripts/run-profiling-tests --python 3.14    # another Python version
#   scripts/run-profiling-tests --quick          # skip rebuild check + full suitespec suites;
#                                                # only run compatibility script
#   scripts/run-profiling-tests --check-only     # run compatibility script only, no suites

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS_DIR="$REPO_ROOT/scripts"
REGISTRY_FILE="$REPO_ROOT/scripts/profiles/profiling_versions.json"

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
PYTHON_VERSION=""
QUICK=false
CHECK_ONLY=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --python)
            PYTHON_VERSION="$2"
            shift 2
            ;;
        --quick)
            QUICK=true
            shift
            ;;
        --check-only)
            CHECK_ONLY=true
            shift
            ;;
        *)
            echo "Unknown argument: $1" >&2
            echo "Usage: $0 [--python VERSION] [--quick] [--check-only]" >&2
            exit 1
            ;;
    esac
done

if [[ -z "$PYTHON_VERSION" ]]; then
    if [[ ! -f "$REGISTRY_FILE" ]]; then
        echo "ERROR: version registry missing: $REGISTRY_FILE" >&2
        exit 1
    fi
    PYTHON_VERSION="$(python3 -c "
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
data = json.loads(path.read_text())
print(data['default_python'])
" "$REGISTRY_FILE")"
fi

# ---------------------------------------------------------------------------
# Locate the Python interpreter
# ---------------------------------------------------------------------------
# Preference order (pyenv last so a stale pyenv 3.15.0a7 cannot beat
# ~/.local/py315rc2 for the migration-replay phase pin):
#   1) explicit PYTHON if it matches major.minor
#   2) version-specific env / known prefixes (PY315RC2, PYTHON314, Homebrew)
#   3) PATH binaries pythonX.Y / python3
#   4) pyenv
_python_matches_version() {
    local exe="$1" version="$2" ver
    [[ -x "$exe" ]] || return 1
    ver=$("$exe" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null) || return 1
    [[ "$ver" == "$version" ]]
}

find_python() {
    local version="$1"
    local candidate=""
    local pyenv_version=""
    local prefix=""

    if [[ -n "${PYTHON:-}" ]] && _python_matches_version "$PYTHON" "$version"; then
        echo "$PYTHON"
        return
    fi

    if [[ "$version" == "3.15" ]]; then
        prefix="${PY315RC2:-${HOME}/.local/py315rc2}"
        for candidate in \
            "${prefix}/bin/python3.15" \
            "${prefix}/bin/python3" \
            "${prefix}/bin/python"
        do
            if _python_matches_version "$candidate" "$version"; then
                echo "$candidate"
                return
            fi
        done
    fi

    if [[ "$version" == "3.14" ]]; then
        for candidate in \
            "${PYTHON314:-}" \
            "/opt/homebrew/bin/python3.14" \
            "/usr/local/bin/python3.14"
        do
            if [[ -n "$candidate" ]] && _python_matches_version "$candidate" "$version"; then
                echo "$candidate"
                return
            fi
        done
    fi

    for candidate in "python${version}" "python3"; do
        if command -v "$candidate" &>/dev/null; then
            candidate="$(command -v "$candidate")"
            if _python_matches_version "$candidate" "$version"; then
                echo "$candidate"
                return
            fi
        fi
    done

    if command -v pyenv &>/dev/null; then
        # `|| true`: unmatched grep is status 1 under `set -euo pipefail`.
        pyenv_version=$(pyenv versions --bare 2>/dev/null | grep "^${version}" | sort -V | tail -1 || true)
        if [[ -n "$pyenv_version" ]]; then
            candidate="$HOME/.pyenv/versions/$pyenv_version/bin/python"
            if _python_matches_version "$candidate" "$version"; then
                echo "$candidate"
                return
            fi
        fi
    fi

    echo ""
}

PYTHON=$(find_python "$PYTHON_VERSION")
if [[ -z "$PYTHON" ]]; then
    echo "ERROR: Python $PYTHON_VERSION not found." >&2
    echo "Tried: PYTHON=${PYTHON:-}, PY315RC2=${PY315RC2:-~/.local/py315rc2}," \
         "PYTHON314=${PYTHON314:-/opt/homebrew/bin/python3.14}, PATH, pyenv." >&2
    echo "Install 3.15rc2 under ~/.local/py315rc2, Homebrew python@3.14, or pyenv." >&2
    exit 1
fi

ACTUAL_VER=$("$PYTHON" -c "import sys; print(sys.version)")
echo "=== Using Python: $ACTUAL_VER ==="
echo "=== Binary: $PYTHON ==="
echo "=== Registry default target: $PYTHON_VERSION ==="
echo ""

# ---------------------------------------------------------------------------
# Step 1: Ensure the stack C extension is up-to-date
# ---------------------------------------------------------------------------
# The incremental build system skips rebuilding existing .so files.  If you
# pull new commits that change stack.cpp (e.g. adding set_max_threads), the
# old .so stays in place and the stack collector silently fails at runtime —
# profiler.py catches the AttributeError and disables the collector without
# surfacing it as a test failure.  Always verify and rebuild if stale.

if [[ "$QUICK" == false && "$CHECK_ONLY" == false ]]; then
    echo "--- Checking stack extension freshness ---"

    EXT_SUFFIX=$("$PYTHON" -c "import sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'))")
    STACK_SO="$REPO_ROOT/ddtrace/internal/datadog/profiling/stack/_stack${EXT_SUFFIX}"

    NEEDS_REBUILD=false

    if [[ ! -f "$STACK_SO" ]]; then
        echo "  Stack extension not found — will build."
        NEEDS_REBUILD=true
    else
        # Check for known required symbols by importing
        if ! "$PYTHON" -c "
from ddtrace.internal.datadog.profiling.stack import _stack as s
missing = [fn for fn in ('set_max_threads', 'set_adaptive_sampling', 'set_target_overhead', 'set_max_sampling_period') if not hasattr(s, fn)]
if missing:
    raise AttributeError('Missing: ' + ', '.join(missing))
" 2>/dev/null; then
            echo "  Stack extension is stale (missing required symbols) — rebuilding."
            NEEDS_REBUILD=true
        else
            echo "  Stack extension is up-to-date. ✓"
        fi
    fi

    if [[ "$NEEDS_REBUILD" == true ]]; then
        # Remove the stale .so so the incremental build detects it as missing
        # and rebuilds only this extension (not Rust or other C extensions).
        rm -f "$STACK_SO"

        echo "  Rebuilding stack extension..."
        cd "$REPO_ROOT"
        # Capture status before filtering: `grep|head` can SIGPIPE a healthy pip
        # and `|| true` would hide a real install failure.
        set +e
        rebuild_log="$("$PYTHON" -m pip install -e . --no-build-isolation -q 2>&1)"
        rebuild_status=$?
        set -e
        echo "$rebuild_log" | grep -E "Building|CMake|error|warning|_stack" | head -30 || true
        if [[ "$rebuild_status" -ne 0 ]]; then
            echo "ERROR: Rebuild failed — pip install exited $rebuild_status." >&2
            echo "$rebuild_log" >&2
            exit 1
        fi

        if [[ ! -f "$STACK_SO" ]]; then
            echo "ERROR: Rebuild failed — $STACK_SO not found after pip install." >&2
            exit 1
        fi
        echo "  Rebuild complete. ✓"
        echo ""
    fi
fi

# ---------------------------------------------------------------------------
# Step 2: Compatibility script (async guards + real profiler samples)
# ---------------------------------------------------------------------------
echo "--- Running verify_profiler_compatibility.py ---"
cd "$REPO_ROOT"

if [[ "$QUICK" == true ]]; then
    "$PYTHON" "$SCRIPTS_DIR/verify_profiler_compatibility.py" --quick
else
    "$PYTHON" "$SCRIPTS_DIR/verify_profiler_compatibility.py" --compare
fi

echo ""

if [[ "$QUICK" == true || "$CHECK_ONLY" == true ]]; then
    if [[ "$CHECK_ONLY" == true ]]; then
        echo "=== --check-only: skipping suitespec suites ==="
    else
        echo "=== --quick: skipping suitespec suites ==="
    fi
    exit 0
fi

# ---------------------------------------------------------------------------
# Step 3: Discover suitespec environment hashes for the target Python version
# ---------------------------------------------------------------------------
# Hashes come from tests/profiling/suitespec.yml via tests.suitespec (Riot was
# removed in #19713). Discover at runtime so suite edits do not hard-code hashes.
discover_suite_hashes() {
    local suite_leaf="$1"
    local python_version="$2"
    (
        cd "$REPO_ROOT" && python3 -c "
from tests.suitespec import get_test_environments

suite = 'profiling::' + '''${suite_leaf}'''
python_version = '''${python_version}'''
matrix = get_test_environments(nightly=False).get(suite, ())
hashes = [env.hash for env in matrix if env.python == python_version]
print(' '.join(hashes))
"
    )
}

PROFILE_HASHES="$(discover_suite_hashes profile "$PYTHON_VERSION")"
MEMALLOC_HASHES="$(discover_suite_hashes profile-memalloc "$PYTHON_VERSION")"

missing_venvs=0
if [[ -z "$PROFILE_HASHES" ]]; then
    echo "ERROR: No 'profile' test environments found for Python $PYTHON_VERSION." >&2
    echo "Add 3.15 (or the requested minor) to tests/profiling/suitespec.yml and regenerate locks." >&2
    missing_venvs=1
else
    echo "--- Running profile suites: $PROFILE_HASHES---"
    # shellcheck disable=SC2086
    VENV_ARGS=""
    for hash in $PROFILE_HASHES; do
        VENV_ARGS="$VENV_ARGS --venv $hash"
    done
    # shellcheck disable=SC2086
    "$SCRIPTS_DIR/run-tests" $VENV_ARGS
    echo ""
fi

if [[ -z "$MEMALLOC_HASHES" ]]; then
    echo "ERROR: No 'profile-memalloc' test environments found for Python $PYTHON_VERSION." >&2
    echo "Add 3.15 (or the requested minor) to tests/profiling/suitespec.yml and regenerate locks." >&2
    missing_venvs=1
else
    echo "--- Running profile-memalloc suites: $MEMALLOC_HASHES---"
    VENV_ARGS=""
    for hash in $MEMALLOC_HASHES; do
        VENV_ARGS="$VENV_ARGS --venv $hash"
    done
    # shellcheck disable=SC2086
    "$SCRIPTS_DIR/run-tests" $VENV_ARGS
    echo ""
fi

if [[ "$missing_venvs" -ne 0 ]]; then
    echo "ERROR: required test environments/suites missing." >&2
    exit 1
fi

UWSGI_SUPPORTED="$(python3 -c "
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
version = sys.argv[2]
data = json.loads(path.read_text())
entry = data.get('versions', {}).get(version, {})
print('true' if entry.get('uwsgi_supported') else 'false')
" "$REGISTRY_FILE" "$PYTHON_VERSION")"
if [[ "$UWSGI_SUPPORTED" == "true" ]]; then
    UWSGI_HASHES="$(discover_suite_hashes profile-uwsgi "$PYTHON_VERSION")"
    if [[ -z "$UWSGI_HASHES" ]]; then
        echo "ERROR: No 'profile-uwsgi' test environments found for Python $PYTHON_VERSION." >&2
        exit 1
    fi
    echo "--- Running profile-uwsgi suites: $UWSGI_HASHES---"
    VENV_ARGS=""
    for hash in $UWSGI_HASHES; do
        VENV_ARGS="$VENV_ARGS --venv $hash"
    done
    # shellcheck disable=SC2086
    "$SCRIPTS_DIR/run-tests" $VENV_ARGS
    echo ""
else
    echo "profile-uwsgi: SKIPPED (registry uwsgi_supported=false for Python $PYTHON_VERSION)"
fi
echo ""
echo "=== All profiling tests completed! ==="
