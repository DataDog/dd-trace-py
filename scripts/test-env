#!/usr/bin/env scripts/uv-run-script
# -*- mode: python -*-
# /// script
# requires-python = ">=3.9"
# dependencies = [
#     "ruamel.yaml>=0.17.21",
# ]
# ///

from __future__ import annotations

import argparse
from collections.abc import Mapping
from collections.abc import Sequence
import concurrent.futures
from contextlib import redirect_stdout
from pathlib import Path
import platform
import subprocess
import sys
import tempfile
from typing import TYPE_CHECKING


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT))

from scripts.check_lockfile_cooldown import cooldown_cutoff  # noqa: E402
from scripts.check_lockfile_cooldown import main as check_lockfile_cooldown  # noqa: E402


if TYPE_CHECKING:
    from tests.suitespec import TestEnvironment


class LockError(RuntimeError):
    """Raised when concrete test-environment locks cannot be generated."""


def _resolve_environments(
    matrices: Mapping[str, tuple[TestEnvironment, ...]], requested: Sequence[str]
) -> tuple[TestEnvironment, ...]:
    environments = tuple(environment for suite in matrices.values() for environment in suite)
    if not requested:
        return environments

    names = set(requested)
    unknown = sorted(names - {environment.name for environment in environments})
    if unknown:
        raise LockError(f"unknown test environment name(s): {', '.join(unknown)}")
    return tuple(environment for environment in environments if environment.name in names)


def select_environments(requested: Sequence[str] = ()) -> tuple[TestEnvironment, ...]:
    from tests.suitespec import get_test_environments

    matrices = get_test_environments(nightly=False)
    return _resolve_environments(matrices, requested)


def _select_suite_environments(suite: str | None) -> tuple[TestEnvironment, ...]:
    from tests.suitespec import get_test_environments

    matrices = get_test_environments(nightly=False)
    if suite is None:
        return tuple(environment for environments in matrices.values() for environment in environments)
    if suite not in matrices:
        matches = [name for name in matrices if name.rsplit("::", 1)[-1] == suite]
        if not matches:
            raise LockError(f"suite has no declarative matrix: {suite}")
        if len(matches) > 1:
            raise LockError(f"ambiguous suite {suite!r}; choose one of: {', '.join(sorted(matches))}")
        suite = matches[0]
    return matrices[suite]


def list_hashes(suite: str | None = None, python_version: str | None = None) -> tuple[str, ...]:
    environments = _select_suite_environments(suite)
    matches = [
        environment for environment in environments if python_version is None or environment.python == python_version
    ]
    if not matches:
        target = f" for {suite}" if suite else ""
        version = f" using Python {python_version}" if python_version else ""
        raise LockError(f"no test locks found{target}{version}")
    return tuple(sorted({environment.lock_hash for environment in matches}))


def _require_lock_platform(command: str) -> None:
    machine = platform.machine().lower()
    if sys.platform == "linux" and machine in {"amd64", "x86_64"}:
        return
    detected = f"{platform.system() or sys.platform} {platform.machine() or 'unknown'}"
    raise LockError(
        f"test locks can only be generated on Linux x86-64; detected {detected}.\n"
        f"Run scripts/ddtest scripts/test-env {command} [name] on a Linux x86-64 host, "
        "or use the Linux x86-64 testrunner image used by CI."
    )


def compile_environment(
    environment: TestEnvironment,
    *,
    exclude_newer: str,
    upgrade: bool,
) -> str:
    from tests.suitespec import LOCK_PLATFORM

    if not environment.riot_lock_dependencies:
        raise LockError(f"environment has no dependencies: {environment.lock_hash}")

    with tempfile.TemporaryDirectory(prefix=f"ddtrace-{environment.lock_hash}-") as temporary:
        temporary_path = Path(temporary)
        requirements = temporary_path / "requirements.in"
        output = temporary_path / "requirements.txt"
        requirements.write_text("\n".join(sorted(environment.riot_lock_dependencies, key=str.casefold)) + "\n")
        existing_lock = PROJECT_ROOT / environment.lockfile
        if existing_lock.is_file():
            output.write_text(existing_lock.read_text())
        command = [
            "uv",
            "pip",
            "compile",
            "--python-version",
            environment.python,
            "--python-platform",
            LOCK_PLATFORM,
            "--exclude-newer",
            exclude_newer,
            "--no-annotate",
            "--no-header",
            "--no-strip-extras",
            "--no-progress",
            "--no-python-downloads",
            "--no-sources",
            "--output-file",
            str(output),
        ]
        if upgrade:
            command.append("--upgrade")
        command.append(str(requirements))
        try:
            subprocess.run(command, cwd=PROJECT_ROOT, check=True, text=True, capture_output=True)
        except subprocess.CalledProcessError as error:
            details = (error.stderr or error.stdout or "").strip()
            suffix = f"\n{details}" if details else ""
            raise LockError(f"failed to lock {environment.name}/{environment.lock_hash}{suffix}") from error
        return output.read_text()


def _write_lock(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file():
        header = []
        for line in path.read_text().splitlines(keepends=True):
            if line.strip() and not line.startswith("#"):
                break
            header.append(line)
        content = "".join(header) + content
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as temporary:
        temporary.write(content)
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


def _unique_lock_environments(environments: Sequence[TestEnvironment]) -> dict[Path, TestEnvironment]:
    unique: dict[Path, TestEnvironment] = {}
    for environment in environments:
        existing = unique.setdefault(environment.lockfile, environment)
        if (existing.python, existing.riot_lock_dependencies) != (
            environment.python,
            environment.riot_lock_dependencies,
        ):
            raise LockError(f"incompatible test environments share {environment.lockfile}")
    return unique


def _lock_inventory() -> tuple[set[Path], set[Path]]:
    from tests.suitespec import LOCK_ROOT

    expected = set(_unique_lock_environments(select_environments()))
    root = PROJECT_ROOT / LOCK_ROOT
    committed = {path.relative_to(PROJECT_ROOT) for path in root.glob("*.txt")}
    return expected, committed


def generate_locks(
    requested: Sequence[str] = (),
    *,
    jobs: int = 4,
    upgrade: bool = False,
    command: str = "lock",
) -> tuple[tuple[Path, ...], tuple[Path, ...]]:
    _require_lock_platform(command)
    environments = select_environments(requested)
    if not environments:
        raise LockError("no concrete test environments selected")

    lock_environments = _unique_lock_environments(environments)
    if not upgrade:
        lock_environments = {
            lockfile: environment
            for lockfile, environment in lock_environments.items()
            if not (PROJECT_ROOT / lockfile).is_file()
        }
    compiled: dict[Path, str] = {}
    cutoff = cooldown_cutoff()
    errors = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, jobs)) as executor:
        futures = {
            executor.submit(compile_environment, environment, exclude_newer=cutoff, upgrade=upgrade): (
                lockfile,
                environment,
            )
            for lockfile, environment in lock_environments.items()
        }
        for future in concurrent.futures.as_completed(futures):
            lockfile, environment = futures[future]
            try:
                compiled[lockfile] = future.result()
            except LockError as error:
                errors.append(error)
    if errors:
        raise LockError("\n\n".join(str(error) for error in errors))

    written = []
    for lockfile in lock_environments:
        _write_lock(PROJECT_ROOT / lockfile, compiled[lockfile])
        written.append(lockfile)

    expected, committed = _lock_inventory()
    pruned = sorted(committed - expected)
    for lockfile in pruned:
        (PROJECT_ROOT / lockfile).unlink()
    return tuple(written), tuple(pruned)


def refresh_locks(
    requested: str | None = None, *, jobs: int = 4
) -> tuple[tuple[str, ...], tuple[Path, ...], tuple[Path, ...]]:
    environments = select_environments((requested,) if requested else ())
    names = tuple(dict.fromkeys(environment.name for environment in environments))
    written, pruned = generate_locks((requested,) if requested else (), jobs=jobs, upgrade=True, command="refresh")
    with redirect_stdout(sys.stderr):
        cooldown_status = check_lockfile_cooldown([str(PROJECT_ROOT / path) for path in written])
    if cooldown_status:
        target = requested or "all test environments"
        raise LockError(f"cooldown validation failed for {target}")
    return names, written, pruned


def check_locks() -> int:
    expected, committed = _lock_inventory()
    missing = sorted(expected - committed)
    obsolete = sorted(committed - expected)
    errors = []
    if missing:
        errors.append("missing test locks:\n" + "\n".join(f"  {path}" for path in missing))
    if obsolete:
        errors.append("obsolete test locks:\n" + "\n".join(f"  {path}" for path in obsolete))
    if errors:
        raise LockError("\n".join(errors))
    return len(expected)


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Manage concrete locks for test environments.")
    subparsers = parser.add_subparsers(dest="command", required=True)
    list_parser = subparsers.add_parser("list", help="List lock hashes, optionally for one test suite.")
    list_parser.add_argument("suite", nargs="?", help="Full or unambiguous short suite name; defaults to all.")
    list_parser.add_argument("--python", help="Only list hashes for this Python version.")
    subparsers.add_parser("check", help="Check that declared environments and committed test locks match.")
    lock_parser = subparsers.add_parser("lock", help="Generate and prune concrete test-environment locks.")
    lock_parser.add_argument("names", nargs="*", help="Exact test environment names; defaults to all.")
    lock_parser.add_argument("--jobs", type=int, default=4, help="Number of concurrent uv resolvers.")
    refresh_parser = subparsers.add_parser("refresh", help="Refresh one named test environment, or all by default.")
    refresh_parser.add_argument("name", nargs="?", help="Exact test environment name; defaults to all.")
    refresh_parser.add_argument("--jobs", type=int, default=4, help="Number of concurrent uv resolvers.")
    args = parser.parse_args(argv)

    try:
        if args.command == "check":
            count = check_locks()
            print(f"Validated {count} concrete test locks.")
            return 0
        if args.command == "list":
            for lock_hash in list_hashes(args.suite, args.python):
                print(lock_hash)
            return 0
        if args.command == "refresh":
            names, written, pruned = refresh_locks(args.name, jobs=args.jobs)
            print(
                f"Locked {len(written)} concrete environment(s); pruned {len(pruned)} obsolete lock(s).",
                file=sys.stderr,
            )
            for name in names:
                print(name)
            return 0
        written, pruned = generate_locks(args.names, jobs=args.jobs)
    except LockError as error:
        parser.error(str(error))
    print(f"Locked {len(written)} concrete environment(s); pruned {len(pruned)} obsolete lock(s).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
