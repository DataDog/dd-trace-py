#!/usr/bin/env scripts/uv-run-script
# -*- mode: python -*-
# /// script
# requires-python = ">=3.8"
# dependencies = [
#     "packaging",
#     "ruamel.yaml>=0.17.21",
# ]
# ///
"""Test runner script for dd-trace-py.

This script helps developers run the appropriate test suites based on changed files.
It maps source files to their corresponding test suites and provides granular control
over which specific test environments to run.

Note: This runs entire test suites, not individual test files.
"""

from __future__ import annotations

import argparse
from contextlib import contextmanager
from dataclasses import dataclass
import fcntl
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from typing import Iterator
from typing import TypeVar

from packaging.version import InvalidVersion
from packaging.version import Version


# Add the project root to import the test configuration.
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def _ensure_compose_project_name():
    """Set COMPOSE_PROJECT_NAME if not already set, using a hash of the project root.

    This ensures concurrent runs from different worktrees get isolated compose
    projects and don't interfere with each other's containers.
    """
    if "COMPOSE_PROJECT_NAME" not in os.environ:
        path_hash = hashlib.sha1(str(ROOT).encode()).hexdigest()[:8]
        os.environ["COMPOSE_PROJECT_NAME"] = f"ddtracepy-{path_hash}"


_ensure_compose_project_name()

from tests.suitespec import TestEnvironment  # noqa: E402
from tests.suitespec import TestRun  # noqa: E402
from tests.suitespec import get_patterns  # noqa: E402
from tests.suitespec import get_suites  # noqa: E402
from tests.suitespec import get_test_environments  # noqa: E402


# Constants
TESTAGENT_PORT_DEFAULT = 9126
PODMAN_COMPAT_ENV_VAR = "DD_TEST_PODMAN_COMPAT"
BASE_COMPOSE_FILE = ROOT / "docker-compose.base.yml"
DOCKER_COMPOSE_FILE = ROOT / "docker-compose.yml"
PODMAN_COMPOSE_FILE = ROOT / "docker-compose.podman.yml"
CONTAINER_PROJECT_ROOT = Path("/home/bits/project")
TEST_CONTAINER_PATH = (
    "/home/bits/.cargo/bin:/home/bits/.local/bin:/home/bits/.pyenv/shims:/home/bits/.pyenv/bin:"
    "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
)
DDTRACE_TEST_WHEEL_ROOT = Path(".cache/ddtrace-test-wheels")
TEST_ENVIRONMENT_ROOT = Path(".cache/test-environments")
TEST_ENVIRONMENT_COMPLETE = ".complete"
TESTMON_REQUIREMENT = "pytest-testmon==2.2.0"
_TESTMON_MIN_PYTHON_VERSION = Version("3.10")
_ITR_MIN_PYTHON_VERSION = Version("3.12")
Selection = TypeVar("Selection")


def _is_true(value: str) -> bool:
    return value.lower() in ("true", "1")


def _python_hint_to_version(hint: str) -> Version | None:
    try:
        return Version(hint)
    except InvalidVersion:
        return None


def _is_protected_ci_branch() -> bool:
    branch = os.environ.get("CI_COMMIT_BRANCH", "")
    return branch == "main" or branch.startswith("mq-")


def _configure_ci_itr_environment(env: dict[str, str], python_hint: str, environment_hash: str) -> None:
    python_version = _python_hint_to_version(python_hint)
    tags = f"test.configuration.riot_hash:{environment_hash}"
    env["_CI_DD_TAGS"] = f"{tags},test.configuration.python:{python_hint}" if python_hint else tags

    if (
        _is_true(env.get("DD_TRACE_PY_ENABLE_ITR_FOR_JOB", "true"))
        and "DD_CIVISIBILITY_ITR_ENABLED" not in env
        and python_version is not None
        and python_version >= _ITR_MIN_PYTHON_VERSION
    ):
        env["DD_CIVISIBILITY_ITR_ENABLED"] = "true"
        if _is_true(env.get("DD_TRACE_PY_ENABLE_ITR_TEST_SKIPPING_FOR_JOB", "false")):
            env["_DD_CIVISIBILITY_ITR_PREVENT_TEST_SKIPPING"] = "0"
        else:
            env.setdefault("_DD_CIVISIBILITY_ITR_PREVENT_TEST_SKIPPING", "1")

        if _is_protected_ci_branch():
            env.setdefault("_DD_CIVISIBILITY_ITR_FORCE_ENABLE_COVERAGE", "true")
            env.setdefault("_DD_CIVISIBILITY_ITR_PREVENT_TEST_SKIPPING", "1")


class TestEnvironmentError(RuntimeError):
    """Raised when a test environment cannot be prepared."""


@dataclass(frozen=True)
class PreparedEnvironment:
    path: Path
    requirements_contents: str
    identity: str
    editable: bool

    @property
    def requirements(self) -> Path:
        return self.path.with_suffix(".txt")


def _short_hash(contents: bytes) -> str:
    return hashlib.sha256(contents).hexdigest()[:12]


def _tia_log(event: str, **fields) -> None:
    print("[TIA] " + json.dumps({"event": event, **fields}, sort_keys=True), flush=True)


def _database_sizes(database: Path) -> dict[str, int]:
    return {path.name: path.stat().st_size for path in database.parent.glob(database.name + "*") if path.is_file()}


def _atomic_write(path: Path, contents: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as temporary:
        temporary.write(contents)
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


class TestRunner:
    def __init__(self):
        self.root = ROOT
        self.podman_compat = os.environ.get(PODMAN_COMPAT_ENV_VAR, "0") == "1"
        self.in_ci = os.environ.get("GITLAB_CI", "").lower() == "true"
        self.suites = get_suites()
        self.environments = get_test_environments(nightly=os.environ.get("NIGHTLY_BUILD", "").lower() == "true")
        self.environments_by_hash = {
            environment.hash: environment for environments in self.environments.values() for environment in environments
        }

    def _uses_testmon(self, environment: TestEnvironment) -> bool:
        python_version = _python_hint_to_version(environment.python)
        return (
            self.in_ci
            and environment.suite == "llmobs::llmobs"
            and python_version is not None
            and python_version >= _TESTMON_MIN_PYTHON_VERSION
        )

    def _testmon_database(self, environment: TestEnvironment, run: TestRun) -> Path:
        # Reuse coverage across source edits, but separate dependency and command variants.
        identity = _short_hash(
            ((self.root / environment.lockfile).read_text() + repr(run) + TESTMON_REQUIREMENT).encode()
        )
        return self.root / ".tia/databases" / environment.hash / identity / ".testmondata"

    def _compose_command(self, *args: str) -> list[str]:
        """Return the Compose command for the selected container backend."""
        cmd = ["docker", "compose"]
        if self.podman_compat:
            cmd.extend(["-f", str(BASE_COMPOSE_FILE), "-f", str(PODMAN_COMPOSE_FILE)])
        else:
            cmd.extend(["-f", str(DOCKER_COMPOSE_FILE)])
        cmd.extend(args)
        return cmd

    def _run_git_command(self, cmd: list[str]) -> set[str]:
        """Helper to run a git command and return set of file paths."""
        result = subprocess.run(cmd, capture_output=True, text=True, cwd=self.root, check=True)
        return set(result.stdout.strip().split()) if result.stdout.strip() else set()

    def get_git_changed_files(self, base_ref: str = "HEAD") -> set[str]:
        """Get files changed in git since base_ref.

        For HEAD (default): returns staged + unstaged + untracked files
        For other refs: returns diff against that ref
        """
        try:
            if base_ref == "HEAD":
                # Get all local changes: staged, unstaged, and untracked
                staged = self._run_git_command(["git", "diff", "--cached", "--name-only"])
                unstaged = self._run_git_command(["git", "diff", "--name-only"])
                untracked = self._run_git_command(["git", "ls-files", "--others", "--exclude-standard"])
                return staged | unstaged | untracked
            else:
                # Get diff against specific ref
                return self._run_git_command(["git", "diff", "--name-only", base_ref])
        except subprocess.CalledProcessError:
            print("Warning: Failed to get git changes, using all suites")
            return set()

    def find_matching_suites(self, files: set[str]) -> dict[str, list[str]]:
        """Find test suites that match the given files."""
        matching = {}

        # Expand directory paths to include glob patterns
        expanded_files = set()
        for file_path in files:
            expanded_files.add(file_path)
            # If it's a directory (ends with / or exists as dir), add wildcard patterns
            path_obj = self.root / file_path.rstrip("/")
            if path_obj.is_dir():
                # Add common directory patterns
                base = file_path.rstrip("/")
                expanded_files.add(f"{base}/*")
                expanded_files.add(f"{base}/**/*")

        for suite_name in self.suites:
            patterns = get_patterns(suite_name)
            matches = sorted({match for pattern in patterns for match in fnmatch.filter(expanded_files, pattern)})
            if matches:
                matching[suite_name] = matches

        return matching

    def start_services(self, services: set[str]) -> bool:
        """Start required Docker services.

        For testagent, first tries the default port (9126). If that fails
        (e.g., another worktree already claimed it), retries with a random
        port by setting TESTAGENT_HOST_PORT=0. When DD_TEST_PODMAN_COMPAT=1,
        all requested services use the Podman host-network Compose override.
        """
        if not services:
            return True

        print(f"\n🐳 Starting required services: {', '.join(sorted(services))}")
        try:
            cmd = self._compose_command("up", "-d", *services)
            subprocess.run(cmd, cwd=self.root, check=True)
            return True
        except subprocess.CalledProcessError:
            if "testagent" in services and not self.podman_compat:
                # NOTE: When falling back to a random port, snapshot tests that
                # hardcode localhost:9126 in their URLs (e.g., in test code or
                # snapshot files) may fail. This only happens for the second+
                # concurrent worktree; the first always gets port 9126.
                print("⚠️  Port conflict detected, retrying testagent with a random port...")
                os.environ["TESTAGENT_HOST_PORT"] = "0"
                try:
                    cmd = self._compose_command("up", "-d", *services)
                    subprocess.run(cmd, cwd=self.root, check=True)
                    return True
                except subprocess.CalledProcessError as e:
                    print(f"❌ Failed to start services: {e}")
                    return False
            else:
                print("❌ Failed to start services")
                return False

    def get_testagent_url(self) -> str:
        """Discover the testagent URL by querying its dynamically assigned host port."""
        if self.podman_compat:
            url = f"http://localhost:{TESTAGENT_PORT_DEFAULT}"
            print(f"🔍 Using host-networked Podman testagent at {url}")
            return url

        try:
            result = subprocess.run(
                self._compose_command("port", "testagent", "8126"),
                capture_output=True,
                text=True,
                cwd=self.root,
            )
            if result.returncode == 0 and result.stdout.strip():
                # Output is like "0.0.0.0:32768" or "127.0.0.1:32768"
                host_port = result.stdout.strip().rsplit(":", 1)[-1]
                url = f"http://localhost:{host_port}"
                print(f"🔍 Discovered testagent at {url}")
                return url
        except Exception as e:
            print(f"⚠️  Failed to discover testagent port: {e}")

        # Fall back to the conventional fixed port
        url = f"http://localhost:{TESTAGENT_PORT_DEFAULT}"
        print(f"⚠️  Falling back to {url}")
        return url

    def stop_services(self, services: set[str]) -> bool:
        """Stop and remove Docker services."""
        if not services:
            return True

        print(f"\n🛑 Stopping services: {', '.join(sorted(services))}")
        try:
            cmd = self._compose_command("down") if self.podman_compat else self._compose_command("down", *services)
            subprocess.run(cmd, cwd=self.root, check=True)
            return True
        except subprocess.CalledProcessError as e:
            print(f"⚠️  Warning: Failed to stop services: {e}")
            return False  # Don't fail the whole run if cleanup fails

    def _parse_selection(self, selection: str, max_items: int) -> set[int]:
        """Parse user selection string into set of indices.

        Handles formats like: '1', '1,3,5', '1-5', '2-4,7,9-11'
        Returns 1-based indices.
        """
        indices = set()
        for part in selection.split(","):
            part = part.strip()
            if "-" in part:
                start, end = map(int, part.split("-"))
                indices.update(range(start, min(end + 1, max_items + 1)))
            else:
                idx = int(part)
                if 1 <= idx <= max_items:
                    indices.add(idx)
        return indices

    def _interactive_select(self, choices: list[tuple[str, Selection]], item_type: str) -> list[Selection]:
        """Select values from a list of display labels and values."""
        if not choices:
            return []

        if len(choices) == 1:
            return [choices[0][1]]

        print(f"\n🎯 Select which {item_type} to run:")
        print("=" * 60)

        for i, (label, _) in enumerate(choices, 1):
            print(f"{i:2d}. {label}")

        while True:
            try:
                print(f"\nSelect {item_type} (e.g., '1,3' for specific, 'all' for everything, or 'none'):")
                selection = input("> ").strip().lower()

                if selection == "none":
                    return []
                elif selection == "all":
                    return [value for _, value in choices]

                indices = self._parse_selection(selection, len(choices))
                if indices:
                    selected = [choices[i - 1][1] for i in sorted(indices)]
                    return selected
                else:
                    print("   No valid items selected")

            except (ValueError, IndexError):
                print("❌ Invalid selection. Please use format like '1,3', 'all', or 'none'")

    def select_suites(self, matching_suites: dict[str, list[str]]) -> dict[str, list[str]]:
        """Let the user select which test suites to run."""
        if not matching_suites:
            print("❌ No test suites found in matching suites")
            return {}

        print(f"\n📋 Found {len(matching_suites)} matching test suite(s):")
        suite_list = list(matching_suites.keys())

        selected = self._interactive_select([(suite, suite) for suite in suite_list], "suites")
        if selected:
            print(f"   Selected suites: {', '.join(selected)}")
            return {name: matching_suites[name] for name in selected}
        return {}

    def select_environments_for_suites(self, selected_suites: dict[str, list[str]]) -> list[TestEnvironment]:
        """Let the user select concrete environments for each suite."""
        selected_environments = []

        for suite_name in selected_suites:
            suite_config = self.suites[suite_name]
            pattern = suite_config.get("pattern", suite_name)
            print(f"\n🔍 Getting available environments for suite '{suite_name}' (pattern: '{pattern}')...")
            environments = list(self.environments.get(suite_name, ()))

            if not environments:
                print(f"   ⚠️  No environments found for suite '{suite_name}'")
                continue

            print(f"\n📋 Available environments for suite '{suite_name}' ({len(environments)} total):")
            print("=" * 80)

            choices = [
                (
                    f"{environment.hash}  {environment.integration_name}/{environment.name}  "
                    f"Python {environment.python}",
                    environment,
                )
                for environment in environments
            ]
            selected = self._interactive_select(choices, "environments")

            if selected:
                selected_environments.extend(selected)
                print(f"   Selected {len(selected)} environment(s) for suite '{suite_name}':")
                for environment in selected:
                    print(f"     • {environment.hash}: {environment.name} (Python {environment.python})")

        return selected_environments

    def interactive_environment_selection(self, matching_suites: dict[str, list[str]]) -> list[TestEnvironment]:
        """Provide interactive test environment selection."""
        if not matching_suites:
            print("❌ No matching test suites found for the changed files.")
            return []

        selected_suites = self.select_suites(matching_suites)
        if not selected_suites:
            return []

        return self.select_environments_for_suites(selected_suites)

    def _prepare_environment(
        self,
        environment: TestEnvironment,
        project_artifact: Path | None,
        unpin_dependencies: bool = False,
    ) -> PreparedEnvironment:
        lockfile = self.root / environment.lockfile
        if not lockfile.is_file():
            raise TestEnvironmentError(f"lockfile does not exist: {environment.lockfile}")

        if unpin_dependencies:
            contents = "".join(f"{dependency}\n" for dependency in environment.direct_dependencies)
        else:
            contents = lockfile.read_text()
        if self._uses_testmon(environment):
            contents += f"\n{TESTMON_REQUIREMENT}\n"
        if project_artifact is None:
            project_file = self.root / "pyproject.toml"
            if not project_file.is_file():
                raise TestEnvironmentError(f"project metadata does not exist: {project_file}")
            project_identity = project_file.read_bytes()
            project_requirement = "-e ."
            editable = True
        else:
            artifact = self.root / project_artifact
            if not artifact.is_file():
                raise TestEnvironmentError(f"project artifact does not exist: {artifact}")
            artifact = artifact.resolve()
            project_identity = artifact.read_bytes()
            project_requirement = str(artifact)
            editable = False

        filtered = "".join(
            line
            for line in contents.splitlines(keepends=True)
            if line.partition("==")[0].strip().casefold() != "ddtrace"
        )
        if filtered and not filtered.endswith("\n"):
            filtered += "\n"
        requirements_contents = f"{filtered}{project_requirement}\n"
        identity = _short_hash(
            b"\0".join(
                (
                    environment.hash.encode(),
                    environment.python.encode(),
                    contents.encode(),
                    project_identity,
                    b"editable-compat" if editable else b"wheel",
                )
            )
        )
        return PreparedEnvironment(
            path=TEST_ENVIRONMENT_ROOT / environment.hash,
            requirements_contents=requirements_contents,
            identity=identity,
            editable=editable,
        )

    def _environment_is_current(self, prepared: PreparedEnvironment) -> bool:
        venv = self.root / prepared.path
        venv_python = venv / "bin/python"
        marker = venv / TEST_ENVIRONMENT_COMPLETE
        if not (venv / "pyvenv.cfg").is_file() or not (venv_python.exists() or venv_python.is_symlink()):
            return False
        try:
            return marker.read_text().strip() == prepared.identity
        except OSError:
            return False

    def _mark_environment_current(self, prepared: PreparedEnvironment) -> None:
        venv = self.root / prepared.path
        venv_python = venv / "bin/python"
        if not (venv / "pyvenv.cfg").is_file() or not (venv_python.exists() or venv_python.is_symlink()):
            raise TestEnvironmentError(f"created an incomplete environment: {prepared.path}")
        _atomic_write(venv / TEST_ENVIRONMENT_COMPLETE, f"{prepared.identity}\n")

    @contextmanager
    def _environment_lock(self, prepared: PreparedEnvironment) -> Iterator[None]:
        venv = self.root / prepared.path
        lock_path = venv.with_name(f".{venv.name}.lock")
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        with lock_path.open("w") as lock_file:
            fcntl.flock(lock_file, fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(lock_file, fcntl.LOCK_UN)

    def _build_environment(
        self,
        environment: TestEnvironment,
        prepared: PreparedEnvironment,
        command_env: dict[str, str],
        reuse_current: bool,
    ) -> bool:
        with self._environment_lock(prepared):
            if reuse_current and self._environment_is_current(prepared):
                return False

            (self.root / prepared.path / TEST_ENVIRONMENT_COMPLETE).unlink(missing_ok=True)
            _atomic_write(self.root / prepared.requirements, prepared.requirements_contents)
            venv_python = prepared.path / "bin/python"
            install = [
                "uv",
                "pip",
                "install",
                "--exact",
                "--python",
                str(venv_python),
                "--requirements",
                str(prepared.requirements),
                "--strict",
                "--no-progress",
            ]
            if prepared.editable:
                install.extend(["--config-settings-package", "ddtrace:editable_mode=compat"])
            commands = (
                [
                    "uv",
                    "venv",
                    "--clear",
                    "--relocatable",
                    "--python",
                    environment.python,
                    "--no-python-downloads",
                    str(prepared.path),
                ],
                install,
            )
            for command in commands:
                wrapped = self._container_command(command, command_env)
                result = subprocess.run(wrapped, env=os.environ.copy(), cwd=self.root)
                if result.returncode != 0:
                    raise TestEnvironmentError(f"build failed for {environment.hash} (exit code {result.returncode})")

            self._mark_environment_current(prepared)
            return True

    def _prebuilt_ddtrace_wheel(self, python: str) -> Path:
        wheel_directory = self.root / DDTRACE_TEST_WHEEL_ROOT / python
        wheels = tuple(wheel_directory.glob("ddtrace-*.whl"))
        if len(wheels) != 1:
            raise TestEnvironmentError(
                f"expected one prebuilt ddtrace wheel for Python {python} in {wheel_directory}, found {len(wheels)}"
            )
        return wheels[0].relative_to(self.root)

    def _container_command(self, command: list[str], environment: dict[str, str]) -> list[str]:
        assignments = [f"{key}={value}" for key, value in sorted(environment.items())]
        if self.in_ci:
            return ["env", *assignments, *command]
        return [str(self.root / "scripts" / "ddtest"), "env", *assignments, *command]

    def _command_environment(self, prepared: PreparedEnvironment, forwarded_env: dict[str, str]) -> dict[str, str]:
        command_env = dict(forwarded_env)
        execution_root = self.root if self.in_ci else CONTAINER_PROJECT_ROOT
        venv = execution_root / prepared.path
        default_path = os.environ.get("PATH", TEST_CONTAINER_PATH) if self.in_ci else TEST_CONTAINER_PATH
        command_env["PATH"] = f"{venv}/bin:{command_env.get('PATH', default_path)}"
        command_env["VIRTUAL_ENV"] = str(venv)
        return command_env

    def _test_command(
        self,
        environment: TestEnvironment,
        prepared: PreparedEnvironment,
        run: TestRun,
        pytest_args: list[str],
        forwarded_env: dict[str, str],
        *,
        use_testmon: bool = True,
        tia_env: dict[str, str] | None = None,
    ) -> list[str]:
        run_env = dict(forwarded_env)
        run_env.update(run.environment)
        if self._uses_testmon(environment):
            database = self._testmon_database(environment, run)
            database.parent.mkdir(parents=True, exist_ok=True)
            run_env.update(
                TESTMON_DATAFILE=str(database),
                DD_CIVISIBILITY_ITR_ENABLED="0",
                _DD_CIVISIBILITY_ITR_FORCE_ENABLE_COVERAGE="false",
                DD_CIVISIBILITY_CODE_COVERAGE_REPORT_UPLOAD_ENABLED="0",
                DD_LLMOBS_TIA_ENVIRONMENT=environment.hash,
            )
            pytest_args = [*pytest_args, "--no-cov", "-p", "scripts.testmon_logging"]
            if use_testmon:
                pytest_args.append("--testmon")
        run_env.update(tia_env or {})

        command = run.command.replace("{cmdargs}", shlex.join(pytest_args))
        if not command.strip():
            raise ValueError(f"empty test command for {environment.hash}")

        run_env["TEST_SUITE"] = environment.integration_name
        if self.in_ci:
            _configure_ci_itr_environment(run_env, environment.python, environment.hash)
        return self._container_command(["bash", "-c", command], self._command_environment(prepared, run_env))

    def _run_tia(self, environment, prepared, run, pytest_args, forwarded_env) -> int:
        diagnostics = os.environ.get("DD_LLMOBS_TIA_DIAGNOSTICS", "off")
        if diagnostics not in ("off", "selection", "full"):
            raise ValueError("DD_LLMOBS_TIA_DIAGNOSTICS must be off, selection, or full")
        database = self._testmon_database(environment, run)
        before = _database_sizes(database)
        fields = {"environment": environment.hash, "python": environment.python}
        _tia_log(
            "run_start",
            **fields,
            commit=os.environ.get("CI_COMMIT_SHA"),
            job_id=os.environ.get("CI_JOB_ID"),
            testmon=TESTMON_REQUIREMENT,
            lock_hash=_short_hash((self.root / environment.lockfile).read_bytes()),
            command=run.command.replace("{cmdargs}", shlex.join(pytest_args)),
            database=str(database.relative_to(self.root)),
            database_present_before=database.is_file(),
            database_accepted="unknown; see testmon's own output",
            database_bytes_before=sum(before.values()),
            database_files_before=before,
            diagnostics=diagnostics,
        )
        with tempfile.TemporaryDirectory(prefix="llmobs-tia-") as temporary:
            scratch = Path(temporary)
            snapshot = scratch / "incoming.db"
            snapshot_started = time.monotonic()
            if diagnostics != "off" and database.is_file():
                # SQLite backup includes committed WAL data without changing the live DB.
                source = sqlite3.connect(database.as_uri() + "?mode=ro", uri=True)
                destination = sqlite3.connect(snapshot)
                try:
                    source.backup(destination)
                finally:
                    destination.close()
                    source.close()
            snapshot_seconds = time.monotonic() - snapshot_started
            inventory = scratch / "normal.json"
            command = self._test_command(
                environment,
                prepared,
                run,
                pytest_args,
                forwarded_env,
                tia_env={"DD_LLMOBS_TIA_INVENTORY": str(inventory), "DD_LLMOBS_TIA_PHASE": "normal"},
            )
            started = time.monotonic()
            result = subprocess.run(command, env=os.environ.copy(), cwd=self.root)
            after = _database_sizes(database)
            _tia_log(
                "run_finish",
                **fields,
                test_process_seconds=time.monotonic() - started,
                exit_code=result.returncode,
                database_bytes_after=sum(after.values()),
                database_growth_bytes=sum(after.values()) - sum(before.values()),
                database_files_after=after,
                timing_scope="pytest process; excludes installation, diagnostics, and CI cache/artifact transfers",
            )
            if diagnostics == "off":
                return result.returncode
            # Probes run after the measured process, each on a separate incoming DB copy.
            started = time.monotonic()
            reports = {}
            phases = ["inventory", "selection"]
            if diagnostics == "full":
                phases += ["full_baseline", "full_recording"]
            diagnostic_failed = False
            for phase in phases:
                phase_db = scratch / f"{phase}.db"
                if snapshot.exists():
                    shutil.copyfile(snapshot, phase_db)
                output = scratch / f"{phase}.json"
                args = [*pytest_args, "--no-ddtrace", "--junitxml="]
                if phase in ("inventory", "selection"):
                    args += ["--collect-only", "-n", "0"]
                if phase == "full_recording":
                    args.append("--testmon-noselect")
                command = self._test_command(
                    environment,
                    prepared,
                    run,
                    args,
                    forwarded_env,
                    use_testmon=phase in ("selection", "full_recording"),
                    tia_env={
                        "TESTMON_DATAFILE": str(phase_db),
                        "DD_LLMOBS_TIA_INVENTORY": str(output),
                        "DD_LLMOBS_TIA_PHASE": phase,
                    },
                )
                phase_started = time.monotonic()
                probe = subprocess.run(command, env=os.environ.copy(), cwd=self.root)
                seconds = time.monotonic() - phase_started
                _tia_log("diagnostic_process", **fields, phase=phase, seconds=seconds, exit_code=probe.returncode)
                report = json.loads(output.read_text()) if output.exists() else None
                valid_codes = (0, 5) if phase == "selection" else (0, 1)
                valid = report is not None and probe.returncode in valid_codes and not report["collection_errors"]
                if not valid:
                    diagnostic_failed = True
                    continue
                reports[phase] = {**report, "seconds": seconds, "exit_code": probe.returncode}
                if probe.returncode == 1:
                    diagnostic_failed = True
            if "inventory" in reports and "selection" in reports:
                all_tests = set(reports["inventory"]["selected"])
                selected = set(reports["selection"]["selected"])
                normal = json.loads(inventory.read_text()) if inventory.exists() else None
                _tia_log(
                    "selection_comparison",
                    **fields,
                    excluded=sorted(all_tests - selected),
                    selected=sorted(selected),
                    unexpected_selected=sorted(selected - all_tests),
                    normal_run_excluded=(
                        sorted(all_tests - set(normal["selected"]))
                        if normal is not None and not normal["collection_errors"]
                        else None
                    ),
                    selection_process_seconds=reports["selection"]["seconds"],
                    scope="serial collect-only probes against the incoming DB; includes startup and imports",
                )
            if "full_baseline" in reports and "full_recording" in reports:
                baseline = reports["full_baseline"]
                recording = reports["full_recording"]
                comparable = (
                    baseline["exit_code"] == recording["exit_code"] == 0
                    and baseline["selected"] == recording["selected"]
                    and baseline["skipped"] == recording["skipped"]
                    and baseline["outcomes"] == recording["outcomes"]
                )
                _tia_log(
                    "coverage_overhead_estimate",
                    **fields,
                    seconds=recording["seconds"] - baseline["seconds"] if comparable else None,
                    comparable=comparable,
                    scope="difference between full runs; includes recording/DB overhead and run-to-run noise",
                )
                if inventory.exists():
                    normal = json.loads(inventory.read_text())
                    missed = set(reports["full_baseline"]["failed"]) - set(normal["selected"])
                    _tia_log("correctness_audit", **fields, excluded_tests_failing_full_run=sorted(missed))
            _tia_log(
                "diagnostics_finish",
                **fields,
                seconds=snapshot_seconds + time.monotonic() - started,
                snapshot_seconds=snapshot_seconds,
                failed=diagnostic_failed,
            )
            return result.returncode or int(diagnostic_failed)

    def _run_environments(
        self,
        environments: list[TestEnvironment],
        forwarded_env: dict[str, str],
        test_args: list[str],
        skip_ddtrace_install: bool,
    ) -> bool:
        pytest_args = test_args[1:] if test_args[:1] == ["--"] else test_args

        if skip_ddtrace_install:
            print("\n⚡ Reusing prebuilt or current ddtrace installations (-s)")

        unpin_dependencies = os.environ.get("UNPIN_DEPENDENCIES", "").lower() == "true"
        for environment in environments:
            try:
                build_env = dict(forwarded_env)
                if environment.runs:
                    build_env.update(environment.runs[0].environment)
                if self.in_ci:
                    if not skip_ddtrace_install:
                        raise TestEnvironmentError(
                            "CI test environments must pass -s/--skip-ddtrace-install to reuse base build artifacts"
                        )
                    project_artifact = self._prebuilt_ddtrace_wheel(environment.python)
                else:
                    project_artifact = None
                prepared = self._prepare_environment(
                    environment,
                    project_artifact,
                    unpin_dependencies=unpin_dependencies,
                )
                command_env = self._command_environment(prepared, build_env)
            except TestEnvironmentError as error:
                print(f"❌ {error}")
                return False

            print(f"\n🔨 Preparing test environment {environment.hash} (Python {environment.python})")
            build_started = time.monotonic()
            try:
                rebuilt = self._build_environment(
                    environment,
                    prepared,
                    command_env,
                    reuse_current=skip_ddtrace_install,
                )
            except TestEnvironmentError as error:
                print(f"❌ {error}")
                return False
            if environment.suite == "llmobs::llmobs" and self.in_ci:
                _tia_log(
                    "environment_prepared",
                    environment=environment.hash,
                    python=environment.python,
                    seconds=time.monotonic() - build_started,
                    rebuilt=rebuilt,
                    testmon_enabled=self._uses_testmon(environment),
                    reason="eligible" if self._uses_testmon(environment) else "testmon requires Python >=3.10",
                )
            if rebuilt:
                print("   ✅ Test environment synchronized successfully")
            elif skip_ddtrace_install:
                print("   ✅ Reusing current test environment; ddtrace install skipped")
            else:
                print("   ✅ Reusing current test environment")

            for run in environment.runs:
                if self._uses_testmon(environment):
                    try:
                        code = self._run_tia(environment, prepared, run, pytest_args, forwarded_env)
                    except (ValueError, OSError, sqlite3.Error) as error:
                        _tia_log("error", environment=environment.hash, error=str(error))
                        return False
                    if code != 0:
                        return False
                    continue
                try:
                    command = self._test_command(environment, prepared, run, pytest_args, forwarded_env)
                except ValueError as error:
                    print(f"❌ {error}")
                    return False

                print(f"\n▶️  Executing {environment.hash}: {' '.join(command)}")
                started = time.monotonic()
                result = subprocess.run(command, env=os.environ.copy(), cwd=self.root)
                if environment.suite == "llmobs::llmobs" and self.in_ci:
                    _tia_log(
                        "run_finish",
                        environment=environment.hash,
                        python=environment.python,
                        testmon_enabled=False,
                        test_process_seconds=time.monotonic() - started,
                        exit_code=result.returncode,
                    )
                if result.returncode != 0:
                    print(f"❌ {environment.hash} failed with exit code {result.returncode}")
                    return False
                print(f"✅ {environment.hash} completed successfully")
        return True

    def run_tests(
        self,
        selected_environments: list[TestEnvironment],
        test_args: list[str] | None = None,
        skip_ddtrace_install: bool = False,
    ) -> bool:
        """Execute the selected environments with per-suite service management."""
        if not selected_environments:
            print("ℹ️  No environments selected for execution.")
            return True

        environments_by_suite: dict[str, list[TestEnvironment]] = {}
        for environment in selected_environments:
            suite_environments = environments_by_suite.setdefault(environment.suite, [])
            if not any(item.hash == environment.hash for item in suite_environments):
                suite_environments.append(environment)

        total_environments = sum(len(environments) for environments in environments_by_suite.values())
        print(f"\n🧪 Running {total_environments} environment(s) across {len(environments_by_suite)} suite(s):")
        for suite_name, environments in environments_by_suite.items():
            run_count = sum(len(environment.runs) for environment in environments)
            if run_count > len(environments):
                print(f"   • Suite '{suite_name}': {len(environments)} environment(s), {run_count} command variants")
            else:
                print(f"   • Suite '{suite_name}': {len(environments)} environment(s)")

        # Execute each suite with its own service lifecycle
        for suite_name, environments in environments_by_suite.items():
            print(f"\n{'=' * 80}")
            print(f"🎯 Suite: {suite_name}")
            print(f"{'=' * 80}")

            suite_config = self.suites[suite_name]
            suite_services = set(suite_config.get("services", ()))
            needs_testagent = bool(suite_config.get("snapshot", False))
            if needs_testagent:
                suite_services.add("testagent")

            # Start services for this suite
            if suite_services and not self.in_ci:
                if not self.start_services(suite_services):
                    print(f"❌ Failed to start services for suite '{suite_name}'")
                    return False
            elif suite_services:
                print(f"ℹ️  Using CI-provisioned services: {', '.join(sorted(suite_services))}")
            else:
                print(f"ℹ️  No services required for suite '{suite_name}'")

            # Set up environment for this suite
            env = os.environ.copy()

            # Apply suite-specific environment variables
            suite_env = {str(key): str(value) for key, value in suite_config.get("env", {}).items()}
            if suite_env:
                for key, value in suite_env.items():
                    value = str(value)
                    # Podman runs both services and the test runner with host
                    # networking, which does not provide Compose service DNS.
                    # Service aliases in suitespec therefore need to target the
                    # host-network endpoint instead.
                    if self.podman_compat and key.endswith("_HOST") and value in suite_services:
                        value = "localhost"
                    env[key] = value
                    print(f"🔧 Setting {key}={value}")

            # Override with testagent URL if needed
            if needs_testagent:
                testagent_url = env.get("DD_TRACE_AGENT_URL") if self.in_ci else self.get_testagent_url()
                if not testagent_url:
                    print("❌ DD_TRACE_AGENT_URL is required for snapshot tests in CI")
                    return False
                env["DD_TRACE_AGENT_URL"] = testagent_url
                print(f"🔧 Setting DD_TRACE_AGENT_URL={testagent_url} for snapshot tests")

            forwarded_env = {key: env[key] for key in suite_env}
            if needs_testagent:
                forwarded_env["DD_TRACE_AGENT_URL"] = env["DD_TRACE_AGENT_URL"]
            suite_success = self._run_environments(
                environments,
                forwarded_env,
                test_args or [],
                skip_ddtrace_install,
            )

            # Stop services for this suite
            if suite_services and not self.in_ci:
                self.stop_services(suite_services)

            # If this suite failed, stop processing further suites
            if not suite_success:
                print(f"\n❌ Suite '{suite_name}' failed. Stopping execution.")
                return False

            print(f"\n✅ Suite '{suite_name}' completed successfully!")

        print("\n🎉 All selected suites completed successfully!")
        return True

    def output_suites_json(self, matching_suites: dict[str, list[str]]) -> None:
        """Output matching suites and venvs as JSON for AI agent consumption."""
        suites_data = []

        for suite_name, matched_files in matching_suites.items():
            venvs_data = []
            for number, environment in enumerate(self.environments.get(suite_name, ())):
                venvs_data.append(
                    {
                        "hash": environment.hash,
                        "number": number,
                        "python_version": environment.python,
                        "packages": ", ".join(environment.direct_dependencies),
                        "command": environment.runs[0].command,
                    }
                )

            suites_data.append(
                {
                    "name": suite_name,
                    "matched_files": matched_files,
                    "venvs": venvs_data,
                }
            )

        # Output JSON
        output = {"suites": suites_data}
        print(json.dumps(output, indent=2))

    def get_environments_by_hash_direct(
        self,
        environment_hashes: list[str],
    ) -> list[TestEnvironment]:
        """Resolve specific environment hashes, preserving the requested order."""
        unique_hashes = tuple(dict.fromkeys(environment_hashes))
        if len(unique_hashes) < len(environment_hashes):
            print(f"ℹ️  Deduplicated {len(environment_hashes)} hash(es) to {len(unique_hashes)} unique hash(es)")
        print(f"📌 Using {len(unique_hashes)} unique environment hash(es): {', '.join(unique_hashes)}")

        missing = [
            environment_hash for environment_hash in unique_hashes if environment_hash not in self.environments_by_hash
        ]
        if missing:
            raise ValueError(f"unknown environment hash: {', '.join(missing)}")
        return [self.environments_by_hash[environment_hash] for environment_hash in unique_hashes]


def main():
    parser = argparse.ArgumentParser(
        description="Run test suites based on changed files",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Run tests for all locally changed files
  scripts/run-tests

  # Run tests for specific files
  scripts/run-tests ddtrace/contrib/flask/patch.py tests/contrib/flask/test_flask.py

  # Run tests for changes since main branch
  scripts/run-tests --git-base=main

  # Reuse a current ddtrace installation for faster reruns
  scripts/run-tests -s --venv <hash>

  # Pass additional arguments to pytest
  scripts/run-tests ddtrace/contrib/django/patch.py -- -vvv -s --tb=short

LLMObs CI logging:
  [TIA] logs report process/setup time, pytest phases, outcomes, configuration,
  and uncompressed DB bytes. Database presence does not prove testmon reused it.
  DD_LLMOBS_TIA_DIAGNOSTICS=selection adds collection probes and excluded test IDs.
  DD_LLMOBS_TIA_DIAGNOSTICS=full also compares full runs with/without recording
  and checks for failures in excluded tests. The default is off.
  Probes use copies of the incoming DB, run after the normal test process,
  and disable Test Visibility reporting. Diagnostics failures fail the job.
  Coverage overhead is an estimate; CI cache/artifact transfer times and
  compressed artifact size remain in GitLab's own logs/UI.
        """,
    )

    parser.add_argument("files", nargs="*", help="Specific files to test (if not provided, uses git changes)")

    parser.add_argument(
        "--git-base", default="HEAD", help="Git ref to compare against for changes (default: HEAD for local changes)"
    )

    parser.add_argument(
        "-s",
        "--skip-ddtrace-install",
        action="store_true",
        help="Reuse a current ddtrace installation instead of reinstalling it",
    )

    parser.add_argument(
        "--all-suites", action="store_true", help="Show all available suites regardless of file changes"
    )

    parser.add_argument(
        "--list", action="store_true", help="Output JSON with all matching suites and venvs (for AI agents)"
    )

    parser.add_argument(
        "--venv",
        action="append",
        help=(
            "Run specific environments by hash without interactive prompts. "
            "Can be used multiple times (e.g., --venv hash1 --venv hash2)"
        ),
    )

    # Parse args before the separator and forward everything after it to the test command.
    if "--" in sys.argv:
        separator_idx = sys.argv.index("--")
        script_args = sys.argv[1:separator_idx]
        test_args = sys.argv[separator_idx + 1 :]
    else:
        script_args = sys.argv[1:]
        test_args = []

    args = parser.parse_args(script_args)
    skip_ddtrace_install = args.skip_ddtrace_install

    runner = TestRunner()

    # Special handling for --venv: skip all file discovery but still need suite info for services
    if args.venv:
        print("🎯 Using directly specified venvs (skipping file/suite analysis)")
        try:
            environments_with_suite = runner.get_environments_by_hash_direct(args.venv)
        except ValueError as error:
            print(f"❌ {error}")
            return 1

        success = runner.run_tests(
            environments_with_suite,
            test_args=test_args,
            skip_ddtrace_install=skip_ddtrace_install,
        )
        return 0 if success else 1

    # Normal flow: determine which files to check
    # When --list is set, status messages go to stderr to keep stdout clean for JSON
    status_out = sys.stderr if args.list else sys.stdout
    if args.files:
        # Use explicitly provided files
        files = set(args.files)
        print(f"📁 Checking explicitly provided files: {', '.join(files)}", file=status_out)
    elif args.all_suites:
        # Use a dummy set that will match all suites
        files = {"*"}
        print("📁 Checking all available test suites", file=status_out)
    else:
        # Use git changes
        files = runner.get_git_changed_files(args.git_base)
        if not files:
            print("ℹ️  No changed files found. Showing all available suites.", file=status_out)
            files = {"*"}
            args.all_suites = True
        else:
            print(f"📁 Found {len(files)} changed file(s): {', '.join(list(files)[:5])}", file=status_out)
            if len(files) > 5:
                print(f"    ... and {len(files) - 5} more", file=status_out)

    # Find matching suites
    matching_suites: dict[str, list[str]]
    if args.all_suites:
        matching_suites = {suite: [] for suite in runner.suites}
    else:
        matching_suites = runner.find_matching_suites(files)
        if not matching_suites:
            print("ℹ️  No matching test suites for the changed files. Showing all available suites.", file=status_out)
            matching_suites = {suite: [] for suite in runner.suites}

    # Handle --list flag (output JSON for AI agents)
    if args.list:
        runner.output_suites_json(matching_suites)
        return 0

    selected_environments = runner.interactive_environment_selection(matching_suites)

    # Execute tests
    success = runner.run_tests(
        selected_environments,
        test_args=test_args,
        skip_ddtrace_install=skip_ddtrace_install,
    )

    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
