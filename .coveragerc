[run]
# Named explicitly: newer coverage.py does not measure recognized third-party
# locations (the test environments' site-packages) inside a directory passed as
# source, and CI imports ddtrace from the installed wheel, not the checkout.
source_pkgs = ddtrace
omit = ddtrace/vendor/*
parallel = true

# Ignore warnings when we run as Python 2.7 and have a Python 3.x file
disable_warnings = couldnt-parse

[paths]
ddtrace =
    ddtrace/
    */site-packages/ddtrace/
source =
    ./
    /root/project/
    /home/bits/project
